<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PTCGL Leaderboard and Match History - a standalone BepInEx plugin.

    It records the result of each match and adds two screens to the client's own UI: a history
    of your matches, and a community leaderboard built from the game's own season record.

    It draws NOTHING during a match and reads nothing beyond match start/end. Prize, deck and
    opponent tracking were all removed, deliberately: there is no in-match advantage left to
    argue about, and that is the whole trust story. Do not reintroduce a live overlay.

    Deliberately independent of the PokeAI work: no card/game-data export, no bulk card fetching
    and no simulator tooling. Keep it that way.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>PtcglLeaderboard</AssemblyName>
    <RootNamespace>PtcglLeaderboard</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0436;MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GameRoot Condition="'$(GameRoot)' == ''">$(USERPROFILE)\The Pokémon Company International\Pokémon Trading Card Game Live</GameRoot>
    <GameManaged Condition="'$(GameManaged)' == ''">$(GameRoot)\Pokemon TCG Live_Data\Managed</GameManaged>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(GameRoot)\BepInEx\core</BepInExCore>
    <BepInExPlugins Condition="'$(BepInExPlugins)' == ''">$(GameRoot)\BepInEx\plugins</BepInExPlugins>
    <!--
      Builds deploy to BepInEx\scripts, not plugins. ScriptEngine (BepInEx.Debug) watches that
      folder and reloads everything in it on F6, so a change costs a build and a keypress instead
      of closing the game, building, relaunching and playing back to wherever the thing is visible.
      ScriptEngine itself lives in plugins and is loaded once at startup.
    -->
    <BepInExScripts Condition="'$(BepInExScripts)' == ''">$(GameRoot)\BepInEx\scripts</BepInExScripts>
  </PropertyGroup>

  <!--
    Dev tools exist in DEBUG builds only. Debug is the dev loop: hot reload into BepInEx\scripts,
    the probes that dump the client's UI and textures to disk, the live-tuning file and the F3/F4
    deck keys. Release is what build.ps1 packages for players, and it contains none of them - no
    files written beside the game, no hotkeys, nothing a player could trip over.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEVTOOLS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Core\HotReload.cs;Core\Probe.cs;Core\CardAspectProbe.cs;Core\TexDump.cs;Core\Tuning.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests\ and Preview\ are gone: both existed only for prize tracking and were already
         broken at HEAD after it was removed. Launcher\ is a separate exe, built on its own. -->
    <Compile Remove="Launcher\**" />
    <None Remove="Launcher\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MatchLogic"><HintPath>$(GameManaged)\MatchLogic.dll</HintPath></Reference>
    <Reference Include="SharedLogicUtils"><HintPath>$(GameManaged)\SharedLogicUtils.dll</HintPath></Reference>
    <Reference Include="RainierClientSDK"><HintPath>$(GameManaged)\RainierClientSDK.dll</HintPath></Reference>
    <Reference Include="TPCI.RainierClient"><HintPath>$(GameManaged)\TPCI.RainierClient.dll</HintPath></Reference>
    <Reference Include="TPCI.Shared.Singletons"><HintPath>$(GameManaged)\TPCI.Shared.Singletons.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="TPCIAssetBundleSystem"><HintPath>$(GameManaged)\TPCIAssetBundleSystem.dll</HintPath></Reference>
    <Reference Include="TPCINetworkSystem"><HintPath>$(GameManaged)\TPCINetworkSystem.dll</HintPath></Reference>
    <Reference Include="TPCI.Shared.Utilities"><HintPath>$(GameManaged)\TPCI.Shared.Utilities.dll</HintPath></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(GameManaged)\UnityEngine.AnimationModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath></Reference>
    <!--
      NOT referenced: UnityEngine.ImageConversionModule, which owns EncodeToPNG / LoadImage.
      It targets netstandard2.1 and this plugin must be net472 for BepInEx's Mono runtime, so
      referencing it fails with CS1705. Avatars.cs calls those two methods by reflection instead -
      they resolve fine at runtime, where the real Unity assemblies are loaded.
    -->
  </ItemGroup>

  <!-- Debug only: a Release build dropped into scripts\ would load alongside an installed copy in
       plugins\, and two copies of the plugin means two of everything. -->
  <Target Name="DeployToScripts" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And Exists('$(BepInExScripts)')">
    <!--
      The .pdb goes too, and is NOT optional. ScriptEngine reads the assembly WITH SYMBOLS, so a
      DLL with no .pdb beside it throws SymbolsNotFoundException out of Mono.Cecil and the plugin
      silently never loads. Silently, because BepInEx's [Logging.Disk] has WriteUnityLog = false:
      the exception is raised on the Unity side and only ever appears in Unity's own Player.log,
      while LogOutput.log just stops after "Loading plugins from ...".
    -->
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(BepInExScripts)"
          Retries="0" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="_DeployedPlugin" />
    </Copy>
    <Message Importance="high" Condition="'@(_DeployedPlugin)' == ''"
             Text="PLUGIN NOT DEPLOYED: the DLL is locked. Press F6 in game once (ScriptEngine reloads from a copy, freeing it) or close the game, then build again." />
    <Message Importance="high" Condition="'@(_DeployedPlugin)' != ''"
             Text="Plugin deployed to $(BepInExScripts) - press F6 in game to reload it." />
  </Target>

</Project>
