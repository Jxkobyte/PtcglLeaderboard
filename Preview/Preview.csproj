<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline previewer for the overlay UI.
    LINKS the real Core sources and drives them with hand-built match states, then renders the
    rows the Tracker produces to preview.html - so the UI can be iterated in seconds instead of
    waiting a minute for PTCGL to launch.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Preview</AssemblyName>
    <RootNamespace>Preview</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0436;MSB3277;CS0649</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GameRoot Condition="'$(GameRoot)' == ''">$(USERPROFILE)\The Pokémon Company International\Pokémon Trading Card Game Live</GameRoot>
    <GameManaged Condition="'$(GameManaged)' == ''">$(GameRoot)\Pokemon TCG Live_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="BoardMock.cs" />
    <Compile Include="Fixture.cs" />
    <Compile Include="Server.cs" />
    <Compile Include="..\Core\Tracker.cs" Link="Tracker.cs" />
    <Compile Include="..\Core\BoardSnapshot.cs" Link="BoardSnapshot.cs" />
    <Compile Include="..\Core\Game.cs" Link="Game.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MatchLogic"><HintPath>$(GameManaged)\MatchLogic.dll</HintPath></Reference>
    <Reference Include="SharedLogicUtils"><HintPath>$(GameManaged)\SharedLogicUtils.dll</HintPath></Reference>
    <Reference Include="RainierClientSDK"><HintPath>$(GameManaged)\RainierClientSDK.dll</HintPath></Reference>
    <Reference Include="TPCI.RainierClient"><HintPath>$(GameManaged)\TPCI.RainierClient.dll</HintPath></Reference>
    <Reference Include="TPCI.Shared.Singletons"><HintPath>$(GameManaged)\TPCI.Shared.Singletons.dll</HintPath></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)\UnityEngine.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath></Reference>
  </ItemGroup>

</Project>
